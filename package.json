{
  "name": "spartan-ng-mcp-server",
  "version": "1.0.3",
  "description": "A Model Context Protocol (MCP) server for Spartan NG Angular components, providing AI assistants with access to component source code, demos, and metadata.",
  "type": "module",
  "main": "./build/index.js",
  "bin": {
    "spartan-ng-mcp": "./build/index.js"
  },
  "files": [
    "build/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf build",
    "prepublishOnly": "npm run clean && npm run build && chmod +x build/index.js",
    "start": "node build/index.js",
    "dev": "tsc && node build/index.js",
    "test": "./test-package.sh",
    "examples": "./examples.sh"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "spartan-ng",
    "spartan",
    "angular",
    "angular-components",
    "ui-components",
    "design-system",
    "typescript",
    "ai-tools",
    "claude",
    "copilot",
    "component-library",
    "angular-ui"
  ],
  "author": "Paul Schick",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulschick/spartan-ng-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/paulschick/spartan-ng-mcp-server/issues"
  },
  "homepage": "https://github.com/paulschick/spartan-ng-mcp-server#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.3",
    "axios": "^1.11.0",
    "zod": "^3.25.76",
    "joi": "^17.13.3"
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "typescript": "^5.9.2"
  }
}
